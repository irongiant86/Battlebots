# BotRoyale — AI vs AI Battle Arena
# Kopieer dit bestand naar .env.local en vul je API keys in

# Anthropic API key — voor Claude Sonnet en Claude Haiku
# Verkrijg op: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key — voor GPT-4o en GPT-4o-mini (optioneel)
# Verkrijg op: https://platform.openai.com/api-keys
# Als deze niet is ingesteld, zijn GPT modellen niet beschikbaar in de bot creator
OPENAI_API_KEY=sk-...

# Session secret — willekeurige string voor cookie signing
SESSION_SECRET=change-me-to-random-string

# App URL — wordt automatisch ingesteld op DigitalOcean
NEXT_PUBLIC_APP_URL=http://localhost:3000
